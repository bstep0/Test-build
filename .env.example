# Copy to .env (docker compose) or set in your host's dashboard.
PUBLIC_URL=https://pools.example.com      # used in emails, payment links and the customer portal
COOKIE_SECURE=1                           # set when served over HTTPS
# Optional integrations (features switch on when the key is present):
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
RESEND_API_KEY=                           # email via Resend
EMAIL_FROM=Your Pool Co <service@example.com>
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
